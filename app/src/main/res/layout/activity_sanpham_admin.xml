<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SanphamAdminActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeaderSanPham"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#CC34B6FF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="16dp">

        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/back"
            android:contentDescription="Back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="33dp"
            android:layout_height="24dp"
            android:layout_marginEnd="15dp"
            android:scaleType="fitXY"
            android:src="@drawable/home_1" />

        <ImageView
            android:id="@+id/ivPerson"
            android:layout_width="33dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            android:src="@drawable/person" />
    </LinearLayout>

    <!-- ScrollView cho nội dung -->
    <ScrollView
        android:id="@+id/svSanpham"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nội dung -->
            <LinearLayout
                android:id="@+id/rzkncr07xzb9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/idIVSSImage"
                    android:layout_width="209dp"
                    android:layout_height="296dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/sgk" />

                <TextView
                    android:id="@+id/idTVName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/book_name"
                    android:textColor="#333333"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/idTVPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/book_price"
                    android:textColor="#F47C25"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Danh mục"
                    android:textColor="#333333"
                    android:textSize="18sp" />

                <!-- TextView cho số lượng -->
                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Số lượng"
                    android:textColor="#333333"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/rhxaahh5u5dk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Mô tả sản phẩm"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMoTa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/book_note"
                    android:textColor="#666666"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llgiohang"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- ImageView cho Edit -->
                <ImageView
                    android:id="@+id/ivEdit"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="32dp"
                    android:contentDescription="Edit"
                    android:src="@drawable/edit_admin"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="12dp" />

                <!-- ImageView cho Delete -->
                <ImageView
                    android:id="@+id/ivDelete"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="Delete"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/delete_admin" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>