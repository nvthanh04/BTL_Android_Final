                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/price"
                android:textColor="#666666"
                android:textSize="16sp"
                android:layout_marginBottom="19dp"
                android:layout_marginStart="34dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="312.000"
                />
            <LinearLayout
                android:id="@+id/ryy7l78cgpt"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#8F000000"
                android:layout_marginBottom="64dp"
                android:orientation="vertical">
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ryb9x8wbnocn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginBottom="400dp"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/r5bzc54anspm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/s0da8ffsw1b34b6ff40"
                    android:paddingVertical="17dp"
                    android:paddingHorizontal="46dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/xacnhan"
                        android:textColor="#05A5FF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Xác nhận"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
