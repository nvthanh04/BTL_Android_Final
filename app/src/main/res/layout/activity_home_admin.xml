<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/border"
    tools:context=".HomeAdminActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Thanh tìm kiếm -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="#CC34B6FF"
            android:paddingVertical="40dp"
            android:paddingLeft="22dp"
            android:paddingRight="10dp"
            android:layout_marginBottom="44dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/back"
                android:scaleType="fitXY"
                android:contentDescription="Biểu tượng Quay lại" />

            <AutoCompleteTextView
                android:id="@+id/searchAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                android:drawableStart="@drawable/cart_find"
                android:hint="Sản phẩm cần tìm..."
                android:inputType="text"
                android:textColor="#000000"
                android:textSize="18sp"
                android:paddingVertical="7dp"
                android:background="@drawable/border"
                android:paddingRight="90dp"
                android:drawablePadding="8dp"/>

            <ImageView
                android:id="@+id/ivAdd"
                android:layout_width="33dp"
                android:layout_height="29dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/add_24"
                android:scaleType="fitXY"
                android:contentDescription="Biểu tượng Thêm" />
        </LinearLayout>

        <!-- Danh mục cuộn ngang -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            android:layout_marginStart="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rtzf3g8ymmof"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Tất cả -->
                <LinearLayout
                    android:id="@+id/rdd5c7c9616o"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/border"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/btnall"
                        android:textColor="#06A5FF"
                        android:textSize="18sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:backgroundTint="#FFFFFF"
                        android:text="Tất cả"/>
                </LinearLayout>

                <!-- Tiểu học -->
                <LinearLayout
                    android:id="@+id/r2gu4o73zmys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="3dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/border"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/btnTieuHoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiểu học"
                        android:textColor="#666666"
                        android:backgroundTint="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- THCS -->
                <LinearLayout
                    android:id="@+id/rcqd2m90ktcg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="7dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/border"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/btnTHCS"
                        android:textColor="#666666"
                        android:textSize="18sp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="THCS"/>
                </LinearLayout>

                <!-- THPT -->
                <LinearLayout
                    android:id="@+id/r8tq6q18v1oh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/border"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/btnTHPT"
                        android:textColor="#666666"
                        android:textSize="18sp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="THPT"/>
                </LinearLayout>

                <!-- Toeic -->
                <LinearLayout
                    android:id="@+id/rkv7c8rticii"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="7dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/border"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/btnToic"
                        android:textColor="#666666"
                        android:textSize="18sp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Toeic"/>
                </LinearLayout>

                <!-- Ielts -->
                <LinearLayout
                    android:id="@+id/ro8ijzhvgyc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="4dp"
                    android:background="@drawable/border"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/btnIelts"
                        android:textColor="#666666"
                        android:textSize="18sp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Ielts"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvbook"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:paddingBottom="10dp" />
    </LinearLayout>

    <!-- Thanh điều hướng dưới -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC34B6FF"
        android:elevation="4dp"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/thanhdieuhuong" />

</LinearLayout>