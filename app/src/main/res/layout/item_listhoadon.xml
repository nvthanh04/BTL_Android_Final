<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="12dp"
	android:background="#FFFFFF"
	android:layout_marginBottom="10dp"
	android:elevation="2dp">

	<!-- Thông tin khách hàng -->
	<TextView
		android:id="@+id/tvTenLabel"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Tên khách hàng:"
		android:textStyle="bold"
		android:textSize="16sp"
		android:textColor="#000000"/>

	<TextView
		android:id="@+id/tvTenKH"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Nguyễn Văn A"
		android:textColor="#000000"
		android:textSize="16sp" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/tvEmailLabel"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Số điện thoại:"
			android:textColor="#555555"
			android:textSize="14sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tvSDTKH"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="000099476"
			android:textColor="#555555"
			android:textSize="14sp" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/tvAddresss"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Địa chỉ:"
			android:textColor="#555555"
			android:textSize="14sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tvAddress"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Tây Sơn"
			android:textColor="#555555"
			android:textSize="14sp" />
	</LinearLayout>

	<!-- Ngày đặt và trạng thái -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginTop="8dp"
		android:weightSum="3">

		<!-- Ngày đặt -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/tvLabelNgayDat"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Ngày đặt:"
				android:textSize="14sp"
				android:textColor="#666666"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tvValueNgayDat"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="13/04/2025"
				android:textSize="14sp"
				android:textColor="#666666"/>
		</LinearLayout>

		<!-- Ngày giao -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/tvLabelNgayGiao"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Ngày giao:"
				android:textSize="14sp"
				android:textColor="#666666"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tvValueNgayGiao"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="15/04/2025"
				android:textSize="14sp"
				android:textColor="#666666"/>
		</LinearLayout>

		<!-- Trạng thái -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/tvLabelTrangThai"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Trạng thái:"
				android:textSize="14sp"
				android:textColor="#009688"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tvValueGiaoHang"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Đang giao"
				android:textSize="14sp"
				android:textColor="#009688"
				android:textStyle="bold"/>
		</LinearLayout>
	</LinearLayout>



	<!-- Tổng tiền & phương thức thanh toán -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginTop="4dp"
		android:weightSum="2">

		<!-- Tổng tiền -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/tvLabelTongTien"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Tổng tiền:"
				android:textSize="14sp"
				android:textColor="#000000"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tvValueTongTien"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="500.000 đ"
				android:textSize="14sp"
				android:textColor="#000000"/>
		</LinearLayout>

		<!-- Phương thức thanh toán -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/tvLabelThanhToan"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Thanh toán:"
				android:textSize="14sp"
				android:textColor="#FF5722"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tvValueTrangThai"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="COD"
				android:textSize="14sp"
				android:textColor="#FF5722"/>
		</LinearLayout>
	</LinearLayout>


	<!-- Danh sách sản phẩm -->
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Sản phẩm:"
		android:textSize="15sp"
		android:textStyle="bold"
		android:layout_marginTop="10dp"
		android:textColor="#333333"/>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recyclerViewSanPham"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:nestedScrollingEnabled="false"
		android:layout_marginTop="4dp"/>

</LinearLayout>
