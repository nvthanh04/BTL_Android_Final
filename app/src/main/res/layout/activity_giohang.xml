<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GiohangActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llhdeadergiohang"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:background="#CC34B6FF"
        android:paddingVertical="16dp"
        android:paddingHorizontal="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBack"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:layout_marginEnd="8dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="←"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvgiohang"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Giỏ hàng" />

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="33dp"
            android:layout_height="29dp"
            android:src="@drawable/home_1"
            android:scaleType="fitXY" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvproduct"
        android:layout_width="match_parent"
        android:layout_height="315dp"
        android:layout_weight="1"
        android:background="@drawable/border" />
    <LinearLayout
        android:id="@+id/lltong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvtong"
            android:textColor="#000000"
            android:textSize="22sp"
            android:layout_marginEnd="12dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Tổng cộng:"
            />
        <TextView
            android:id="@+id/tvtien"
            android:textColor="#F47C25"
            android:textSize="22sp"
            android:layout_marginEnd="9dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="0 đ"
            />
        <LinearLayout
            android:id="@+id/llmua"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#CC34B6FF"
            android:paddingVertical="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvmua"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mua hàng"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>